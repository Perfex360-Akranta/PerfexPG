<div  class="sub-header" align=left>Employee Cost Actual</div>   	
	<div title="Employee Cost Actual"  style="padding:10px;" id="empCostActDiv"  align="left">
	<form id="frmEmpCostAct" name="frmEmpCostAct">
       <table width="100%">
           <tr>
               <!--top left content -->
               <td class="valigncnt" valign='top' style="width:40%;">
                   <div style="float:left;margin-left: px;">
