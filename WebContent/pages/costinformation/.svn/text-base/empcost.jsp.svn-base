             </div>          

             <br>
                 
       		<div align="center" style="float: top; padding-right: 0px">
       		<br><br>
			<input type="button" id="btnEmpEstInsert" name="btnEmpEstInsert" class="easyui-button" value="Insert" style="width: 80px;"> 
			<input type="button" id="btnEmpEstClear" name="btnEmpEstClear" class="easyui-button" value="Clear" style="width: 80px;">						
       </div>
       </div>
      </form>
    </div>
    
     <table width="100%">
   		<tr>
   		<td class="valigncnt" colspan="2" valign="middle" align="center" width="70%">
