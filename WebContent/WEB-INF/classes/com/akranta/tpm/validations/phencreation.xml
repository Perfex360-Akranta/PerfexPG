			<property name="BphmAssemblyid" type="String" required="true"  />			 
			<property name="BphmPhenomenaname" type="String" required="true"  />	
		</validate>
	</class>
	<class id="BdmTlCausemst" name="com.akranta.tpm.model.BdmTlCausemst" >
		<validate For="create update">
			<property name="BcsmPhenomenaid" type="String" required="true"  />			 
			<property name="BcsmName" type="String" required="true"  />	
		</validate>
	</class>
</validations>
