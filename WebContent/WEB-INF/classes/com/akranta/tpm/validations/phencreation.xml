			<property name="BnprProposedphn" type="String" required="true"  /> 
			<property required-dependent="true" name="BnprIscausereq" type="String" value="Y">
				<field name="BnprProposedcause" type="String" required="true" />
			</property>				
		</validate>
	</class>
	<class id="BdmTlPhenomenamst" name="com.akranta.tpm.model.BdmTlPhenomenamst" >
