<?xml version="1.0" encoding="UTF-8"?>

<validations>
<!-- Emp Cost -->
	<class id="WomTlManpowercostplan" name="com.akranta.tpm.model.WomTlManpowercostplan" >
		<validate For="create update">				
			<property name="MpcpSkillid" type="String" required="true"  /> 
			<property name="MpcpManpowerid" type="String" required="true"  />
			<property name="MpcpNormalmins" type="String" required="true"  />
			<property name="MpcpNormalcost" type="String" required="true"  />			
		</validate>
	</class>

	<class id="WomTlManpowercostactual" name="com.akranta.tpm.model.WomTlManpowercostactual" >
		<validate For="create update">
			<property name="MpcsSkillid" type="String" required="true"  /> 
			<property name="MpcsManpowerid" type="String" required="true"  />
			<property name="MpcsDate" type="Date" required="true"  />
			<property name="MpcsNormalwt" type="String" required="true"  />
			<property name="MpcsHolidaywt" type="String" required="true"  />
			<property name="MpcsOtherwt" type="String" required="true"  />
			<property name="MpcsActivity" type="String" required="true"  />
		</validate>
	</class>	

	<class id="CostInfoBean" name="com.akranta.tpm.bean.CostInfoBean" >
		<validate For="create update">
		<property name="MpcsDate" type="Date" LE="StartDate"/>
		<property name="MpcsDate" type="Date" GE="EndDate"/>		  			
		</validate>	
	</class>
	
<!-- Spare Cost -->
	<class id="WomTlSparecostplan" name="com.akranta.tpm.model.WomTlSparecostplan" >
		<validate For="create update">
			<property name="WscpRequestedby" type="String" required="true"  /> 
			<property name="WscpSparesid" type="String" required="true"  />
			<property name="WscpQuantity" type="String" required="true"  />
		</validate>
	</class>

	<class id="WomTlSparecostactual" name="com.akranta.tpm.model.WomTlSparecostactual" >
		<validate For="create update">
			<property name="WscaRequestedby" type="String" required="true"  /> 
			<property name="WscaSparesid" type="String" required="true"  />
			<property name="WscaQuantity" type="String" required="true"  />
		</validate>
	</class>	
	
