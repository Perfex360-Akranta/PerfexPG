			<property name="ProgMonth" type="Date" required="true"  />
			 <property required-dependent="true" name="ProgRepeatedProgram" type="String" value="Y">
				<field name="ProgEffectiveFrom" type="String" required="true" />
			</property>
<!-- 			<property name="ProgUniquepos" type="String" required="true" /> -->
<!-- 			<property name="ProgTgtmKeyid" type="String" required="true" /> -->
		</validate>	
	</class>
	<class id="EntBatchMst" name="com.akranta.tpm.model.EntBatchMst" >
