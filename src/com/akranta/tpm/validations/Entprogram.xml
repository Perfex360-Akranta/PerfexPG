			<property name="ProgMinDuration" type="String" required="true" />
			<property name="ProgMaxDuration" type="String" required="true"  />
			<property name="ProgTrarKeyid" type="String" required="true" />
			<property name="ProgIsEvaluationNeed" type="boolean" required="true" />
<!-- 			<property name="ProgSpokeKeyid" type="String" required="true" /> -->
		</validate>
		<validate For="createTrngCal updateTrngCal">
			<!-- <property name="ProgKeyid" type="String" required="true"  /> -->
